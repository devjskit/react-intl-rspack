{
  "name": "@devjskit/react-intl-rspack",
  "version": "0.1.0-alpha.3",
  "license": "MIT",
  "description": "@devjskit/react-intl-rspack is a rspack plugin for creating langs and i18n index file.",
  "author": "Billgo <hi@billgo.me>",
  "bugs": "https://github.com/devjskit/react-intl-rspack/issues",
  "repository": "git+ssh://git@github.com:devjskit/react-intl-rspack.git",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunx rimraf dist && bunx tsdown --config tsdown.config.mts",
    "test": "bun test",
    "dev": "tsdown --config-loader unrun --watch"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "react-intl": "^10.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@devjskit/biome-config": "^0.2.1",
    "@rsbuild/core": "^2.0.3",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@types/web": "^0.0.347",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "*",
    "react-intl": "*"
  },
  "inlinedDependencies": {
    "@rspack/binding": "2.0.1",
    "@rspack/core": "2.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
