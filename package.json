{
  "name": "@devjskit/react-intl-rspack",
  "version": "0.1.0-alpha.3",
  "license": "MIT",
  "description": "@devjskit/react-intl-rspack is a rspack plugin for creating langs and i18n index file.",
  "author": "Billgo <hi@billgo.me>",
  "bugs": "https://github.com/devjskit/react-intl-rspack/issues",
  "repository": "git+ssh://git@github.com:devjskit/react-intl-rspack.git",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./*": "./*"
  },
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "bunx rimraf dist && bunx tsup",
    "start": "bun run --watch examples/index.ts"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "react-intl": "^10.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@devjskit/biome-config": "^0.2.1",
    "@rsbuild/core": "^2.0.3",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@types/web": "^0.0.347",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "*",
    "react-intl": "*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
